# Variables de entorno para ms-security
# Copia este archivo a .env y ajusta los valores

# Servidor
SERVER_PORT=8081

# Base de datos
POSTGRES_URL=jdbc:postgresql://localhost:5437/eduaircontrol_security
POSTGRES_USER=security_user
POSTGRES_PASSWORD=security_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_TTL=3600
JWT_DEVICE_TTL=31536000
SECURITY_RSA_PRIVATE_KEY_PATH=/app/keys/private.pem
SECURITY_RSA_PUBLIC_KEY_PATH=/app/keys/public.pem

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# OAuth2
OAUTH2_ISSUER=http://localhost:8081
OAUTH2_WEB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/web
OAUTH2_MOBILE_REDIRECT_URI=eduaircontrol://oauth2/callback

# SuperAdmin (seed inicial)
SUPERADMIN_EMAIL=admin@eduaircontrol.com
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=changeme

# Rate limiting
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
REFRESH_TTL_DAYS=7

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
SOCIAL_CALLBACK_BASE_URL=

# SMTP (recuperación de contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=

# Observabilidad
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus