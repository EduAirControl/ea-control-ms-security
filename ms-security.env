# ms-security — Environment variables for local development
# Port: 8081 | DB: eduaircontrol_security | Schema: seguridad
# Uses RSA keys (not shared HS256 secret)

SERVER_PORT=8081
POSTGRES_URL=jdbc:postgresql://localhost:5437/eduaircontrol_security
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# OAuth2
OAUTH2_ISSUER=http://localhost:8081
OAUTH2_WEB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/web
OAUTH2_MOBILE_REDIRECT_URI=eduaircontrol://oauth2/callback

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (RSA keys in src/main/resources/keys/)
JWT_ACCESS_TTL=3600
SECURITY_RSA_PRIVATE_KEY_PATH=keys/dev-private.pem
SECURITY_RSA_PUBLIC_KEY_PATH=keys/dev-public.pem

# Security policies
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
REFRESH_TTL_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SuperAdmin bootstrap
SUPERADMIN_EMAIL=superadmin@eduaircontrol.com
SUPERADMIN_USERNAME=superadmin2
SUPERADMIN_PASSWORD=SuperAdmin2026!

# Social login (optional, empty for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173